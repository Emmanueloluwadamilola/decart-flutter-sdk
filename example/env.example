# Choose exactly one authentication mode.

# Production (recommended): public endpoint that returns short-lived ek_ tokens.
# DECART_TOKEN_ENDPOINT=https://your-backend.com/decart/client-token

# Local testing/prototyping only: direct permanent key. This works only in a
# Flutter debug build. Never commit, distribute, profile, or release this key.
# DECART_API_KEY=dct_your_test_key
